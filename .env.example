# Copia este archivo como ".env" y completa los valores.
# ".env" está excluido de Git. Aquí no debe escribirse ningún valor real.

# development | test | production
RECLU_ENVIRONMENT=development
RECLU_LOG_LEVEL=INFO

# SQL Server 2022 (obligatorio en producción). Requiere ODBC Driver 18.
# RECLU_DATABASE_URL=mssql+pyodbc://<USUARIO>:<CONTRASENA>@<SERVIDOR>:1433/<BASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
RECLU_DATABASE_URL=

# Redis: solo intermediario de tareas.
# RECLU_REDIS_URL=redis://localhost:6379/0
RECLU_REDIS_URL=

# Ruta absoluta del almacenamiento documental privado, fuera del directorio público.
# RECLU_STORAGE_ROOT=/srv/reclutamiento/storage
RECLU_STORAGE_ROOT=

# Carpeta del equipo anfitrión que Docker monta como almacenamiento (solo Docker Compose).
RECLU_STORAGE_HOST_PATH=

# Permite enviar documentos reales a proveedores de IA. Mantener en false en
# desarrollo y pruebas; solo datos sintéticos.
RECLU_AI_ALLOW_REAL_DOCUMENTS=false

# Dirección interna de la API para el frontend en desarrollo (no es pública).
API_INTERNAL_URL=http://localhost:8000

# Solo para el SQL Server local opcional de Docker Compose (perfil "sqlserver-local").
MSSQL_SA_PASSWORD=

# Las API keys de Anthropic y OpenAI NO van aquí en la operación normal:
# se registran desde la pantalla "Configuración de inteligencia artificial" (Fase 4).
