# Variables del entorno de PRUEBAS.
# Copia este archivo como "pruebas.env" EN EL SERVIDOR y completa los valores.
# "pruebas.env" no debe subirse al repositorio (los archivos *.env están excluidos de Git).
# En ESTE archivo de ejemplo no se escribe ningún valor real: los valores reales
# (contraseñas y API keys) van solo en la copia del servidor.

RECLU_ENVIRONMENT=test
RECLU_LOG_LEVEL=INFO

# SQL Server 2022 de la empresa. Usuario de la aplicación con permisos mínimos
# (database/sqlserver/permisos_usuario_aplicacion.sql). Con cifrado en tránsito.
RECLU_DATABASE_URL=mssql+pyodbc://<USUARIO_APP>:<CONTRASENA>@<SERVIDOR>:1433/<BASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Carpeta del servidor donde se guardan los documentos (fuera de los contenedores).
RECLU_STORAGE_HOST_PATH=/srv/reclutamiento/storage

# Archivo de la clave maestra en el servidor. Se crea una sola vez con
#   python -m app.cli generate-master-key --output <ruta>
# Solo lectura para el usuario de la aplicación, fuera del respaldo de documentos.
RECLU_MASTER_KEY_HOST_FILE=/etc/reclutamiento/clave_maestra

# Certificado HTTPS y su clave privada.
RECLU_TLS_CERT_HOST_FILE=/etc/reclutamiento/tls/servidor.crt
RECLU_TLS_KEY_HOST_FILE=/etc/reclutamiento/tls/servidor.key

# Antivirus: "clamd" usa el ClamAV incluido. "disabled" exige una decisión expresa.
RECLU_ANTIVIRUS_MODE=clamd

# En pruebas SIEMPRE false: solo datos sintéticos. Base de datos, carpeta de
# documentos y clave maestra deben ser distintas de las de producción.
RECLU_AI_ALLOW_REAL_DOCUMENTS=false

# Zona horaria para reportes y fechas en pantalla.
RECLU_DISPLAY_TIMEZONE=America/Mexico_City

# Direcciones desde las que la API acepta la cabecera con la IP real del usuario.
# Con el archivo de Compose propuesto, la API solo es alcanzable desde el proxy.
FORWARDED_ALLOW_IPS=*

# --- API keys de los proveedores de IA -------------------------------------------
# Escribe aquí la clave de cada proveedor que se vaya a usar, sin comillas ni
# espacios, y deja vacías las demás. Ejemplo de forma: RECLU_GEMINI_API_KEY=AIza...
#
# - La aplicación las lee al arrancar: después de cambiarlas hay que reiniciar
#   los contenedores "api" y "worker".
# - En la pantalla «IA» aparecen como "definida por Sistemas" (solo se ven los
#   últimos cuatro caracteres) y desde ahí no se pueden cambiar ni revocar.
# - Con la clave puesta, el administrador todavía debe entrar a «IA», pulsar
#   «Probar conexión», habilitar el proveedor y asignar los modelos.
# - Este archivo contiene secretos: solo lectura para el usuario que despliega
#   (chmod 600), nunca al repositorio, al correo ni a un chat.
RECLU_ANTHROPIC_API_KEY=
RECLU_OPENAI_API_KEY=
RECLU_GEMINI_API_KEY=
