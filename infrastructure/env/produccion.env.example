# Variables del entorno de PRODUCCIÓN.
# Copia este archivo como "produccion.env" EN EL SERVIDOR y completa los valores.
# "produccion.env" no debe subirse al repositorio (los archivos *.env están excluidos de Git).
# Aquí no se escribe ningún valor real.

RECLU_ENVIRONMENT=production
RECLU_LOG_LEVEL=INFO

# SQL Server 2022 de la empresa. Usuario de la aplicación con permisos mínimos
# (database/sqlserver/permisos_usuario_aplicacion.sql). Con cifrado en tránsito.
RECLU_DATABASE_URL=mssql+pyodbc://<USUARIO_APP>:<CONTRASENA>@<SERVIDOR>:1433/<BASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Carpeta del servidor donde se guardan los documentos (fuera de los contenedores).
RECLU_STORAGE_HOST_PATH=/srv/reclutamiento/storage

# Archivo de la clave maestra en el servidor. Se crea una sola vez con
#   python -m app.cli generate-master-key --output <ruta>
# Solo lectura para el usuario de la aplicación, fuera del respaldo de documentos.
RECLU_MASTER_KEY_HOST_FILE=/etc/reclutamiento/clave_maestra

# Certificado HTTPS y su clave privada.
RECLU_TLS_CERT_HOST_FILE=/etc/reclutamiento/tls/servidor.crt
RECLU_TLS_KEY_HOST_FILE=/etc/reclutamiento/tls/servidor.key

# Antivirus: "clamd" usa el ClamAV incluido. "disabled" exige una decisión expresa.
RECLU_ANTIVIRUS_MODE=clamd

# Permite enviar documentos reales a los proveedores de IA. Activarlo es una
# decisión del responsable del sistema, con el aviso de privacidad vigente.
RECLU_AI_ALLOW_REAL_DOCUMENTS=false

# Zona horaria para reportes y fechas en pantalla.
RECLU_DISPLAY_TIMEZONE=America/Mexico_City

# Direcciones desde las que la API acepta la cabecera con la IP real del usuario.
# Con el archivo de Compose propuesto, la API solo es alcanzable desde el proxy.
FORWARDED_ALLOW_IPS=*

# Las API keys de Anthropic y OpenAI se registran desde la pantalla
# "Configuración de IA" (quedan cifradas). No van en este archivo.
