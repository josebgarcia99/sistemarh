{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Base de datos: crear o actualizar tablas",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": [
        "upgrade",
        "head"
      ],
      "cwd": "${workspaceFolder}/database",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Crear usuario maestro (una sola vez)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": [
        "create-admin"
      ],
      "cwd": "${workspaceFolder}/apps/api",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/apps/api",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Worker (Celery)",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A",
        "worker.celery_app",
        "worker",
        "--loglevel=INFO",
        "--pool=solo"
      ],
      "cwd": "${workspaceFolder}/apps/worker",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Pruebas de la API (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/api",
      "justMyCode": true
    },
    {
      "name": "Frontend (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "3. Sistema (API + Frontend)",
      "configurations": [
        "API (FastAPI)",
        "Frontend (Next.js)"
      ],
      "stopAll": true
    }
  ]
}
