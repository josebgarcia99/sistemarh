[importlinter]
root_package = app

# El núcleo y la infraestructura compartida no conocen los módulos de negocio.
[importlinter:contract:core-sin-modulos]
name = core no depende de modules ni de composition
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.composition

[importlinter:contract:infraestructura-sin-modulos]
name = infrastructure compartida no depende de modules
type = forbidden
source_modules =
    app.infrastructure
forbidden_modules =
    app.modules
    app.composition

# Dentro de cada módulo las dependencias apuntan hacia el dominio.
[importlinter:contract:capas-de-los-modulos]
name = capas de cada modulo (api > infrastructure > application > domain)
type = layers
layers =
    api
    infrastructure
    application
    domain
containers =
    app.modules.users
    app.modules.authentication
    app.modules.audit
    app.modules.vacancies
    app.modules.vacancy_transfers
    app.modules.file_management
    app.modules.ai_settings
    app.modules.evaluation_setup
    app.modules.cv_processing
    app.modules.recruitment
    app.modules.phone_calls
    app.modules.assessments
    app.modules.reporting

[importlinter:contract:capas-system]
name = capas del modulo system
type = layers
layers =
    api
    infrastructure
    application
containers =
    app.modules.system

# Reglas de negocio independientes: auditoría no conoce a nadie y usuarios no
# conoce las sesiones (usa su propio puerto SessionRevoker).
[importlinter:contract:auditoria-independiente]
name = el dominio de audit no depende de otros modulos
type = forbidden
source_modules =
    app.modules.audit.domain
    app.modules.audit.application
forbidden_modules =
    app.modules.users
    app.modules.authentication
    app.modules.system

[importlinter:contract:usuarios-sin-sesiones]
name = el dominio de users no depende de authentication
type = forbidden
source_modules =
    app.modules.users.domain
    app.modules.users.application
forbidden_modules =
    app.modules.authentication
    app.modules.system

# Vacantes no conoce a usuarios, sesiones ni transferencias: usa sus propios
# puertos (UserLookup) y un aviso de alta (on_created).
[importlinter:contract:vacantes-independiente]
name = el dominio de vacancies no depende de otros modulos de negocio
type = forbidden
source_modules =
    app.modules.vacancies.domain
    app.modules.vacancies.application
forbidden_modules =
    app.modules.users
    app.modules.authentication
    app.modules.vacancy_transfers
    app.modules.system

# El almacenamiento documental es independiente del reclutamiento: quién puede
# leer o escribir lo decide un puerto (FileAccessPolicy) que se conecta en
# composition.
[importlinter:contract:documentos-independiente]
name = file_management no depende de los modulos de reclutamiento
type = forbidden
source_modules =
    app.modules.file_management.domain
    app.modules.file_management.application
    app.modules.file_management.infrastructure
forbidden_modules =
    app.modules.vacancies
    app.modules.vacancy_transfers
    app.modules.users
    app.modules.system

[importlinter:contract:ia-independiente]
name = ai_settings no depende de otros modulos de negocio
type = forbidden
source_modules =
    app.modules.ai_settings.domain
    app.modules.ai_settings.application
    app.modules.ai_settings.infrastructure
forbidden_modules =
    app.modules.vacancies
    app.modules.vacancy_transfers
    app.modules.file_management
    app.modules.users
    app.modules.system

# La evaluación de CV no conoce documentos, prompts ni proveedores de IA: usa
# sus propios puertos (CvFiles, Rubrics, Evaluator), conectados en composition.
[importlinter:contract:cv-independiente]
name = cv_processing no depende de documentos, prompts ni IA
type = forbidden
source_modules =
    app.modules.cv_processing.domain
    app.modules.cv_processing.application
    app.modules.cv_processing.infrastructure
forbidden_modules =
    app.modules.file_management
    app.modules.evaluation_setup
    app.modules.ai_settings
    app.modules.vacancy_transfers
    app.modules.system

# El reclutamiento y las llamadas no conocen los lotes de CV, los prompts, los
# documentos ni la IA: usan sus propios puertos, conectados en composition.
[importlinter:contract:reclutamiento-independiente]
name = recruitment y phone_calls no dependen de CV, prompts, documentos ni IA
type = forbidden
source_modules =
    app.modules.recruitment.domain
    app.modules.recruitment.application
    app.modules.recruitment.infrastructure
    app.modules.phone_calls.domain
    app.modules.phone_calls.application
    app.modules.phone_calls.infrastructure
forbidden_modules =
    app.modules.cv_processing
    app.modules.evaluation_setup
    app.modules.file_management
    app.modules.ai_settings
    app.modules.vacancy_transfers
    app.modules.system

# Las evaluaciones posteriores usan sus propios puertos para permisos,
# documentos, expediente e IA.
[importlinter:contract:evaluaciones-independiente]
name = assessments no depende de otros modulos de negocio
type = forbidden
source_modules =
    app.modules.assessments.domain
    app.modules.assessments.application
    app.modules.assessments.infrastructure
forbidden_modules =
    app.modules.recruitment
    app.modules.phone_calls
    app.modules.cv_processing
    app.modules.evaluation_setup
    app.modules.file_management
    app.modules.ai_settings
    app.modules.vacancies
    app.modules.vacancy_transfers
    app.modules.system

# Los reportes son un modelo de lectura: solo su infraestructura consulta las
# tablas de los demás módulos. Sus cálculos no dependen de nadie.
[importlinter:contract:reportes-independiente]
name = el calculo de reportes no depende de otros modulos de negocio
type = forbidden
source_modules =
    app.modules.reporting.domain
    app.modules.reporting.application
forbidden_modules =
    app.modules.recruitment
    app.modules.phone_calls
    app.modules.assessments
    app.modules.cv_processing
    app.modules.evaluation_setup
    app.modules.file_management
    app.modules.ai_settings
    app.modules.vacancies
    app.modules.vacancy_transfers
    app.modules.users
    app.modules.authentication
    app.modules.system
